{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-definitions.schema.json",
  "title": "Thien Document Evidence shared definitions",
  "type": "object",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "decimalString": {
      "type": "string",
      "pattern": "^[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "timestampOrState": {
      "oneOf": [
      {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
      },
        {
          "enum": [
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        }
      ]
    },
    "fieldStatus": {
      "enum": [
        "PRESENT",
        "NOT_PRESENT",
        "NOT_APPLICABLE",
        "ILLEGIBLE",
        "PARTIALLY_ILLEGIBLE",
        "OBSCURED",
        "REDACTED",
        "CONFLICTING",
        "AMBIGUOUS",
        "INFERRED",
        "DERIVED",
        "UNVERIFIED",
        "VERIFIED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "validationStatus": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNING",
        "FAIL",
        "NOT_TESTED",
        "NOT_APPLICABLE",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "matchStatus": {
      "enum": [
        "EXACT_MATCH",
        "WITHIN_TOLERANCE",
        "STRONG_CANDIDATE",
        "PARTIAL_MATCH",
        "AMBIGUOUS_MATCH",
        "CONFLICTING_MATCH",
        "UNMATCHED",
        "NOT_APPLICABLE",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "qualityStatus": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "CONDITIONAL",
        "FAIL",
        "BLOCKED",
        "NOT_TESTED",
        "ERROR"
      ]
    },
    "readinessStatus": {
      "enum": [
        "DRAFT",
        "READY_FOR_QA",
        "READY_FOR_HUMAN_VALIDATION",
        "READY_FOR_RECONCILIATION",
        "READY_FOR_LIMITED_USE",
        "READY_FOR_HUMAN_REVIEW",
        "BLOCKED",
        "NOT_EXECUTED"
      ]
    },
    "humanReviewStatus": {
      "enum": [
        "NOT_REQUIRED",
        "REQUIRED",
        "PENDING",
        "IN_PROGRESS",
        "COMPLETED",
        "ESCALATED",
        "UNKNOWN"
      ]
    },
    "humanApprovalStatus": {
      "enum": [
        "NOT_REQUESTED",
        "PENDING",
        "APPROVED",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "confidenceBand": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "band",
        "source"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "band": {
          "$ref": "#/$defs/confidenceBand"
        },
        "source": {
          "enum": [
            "ENGINE_REPORTED",
            "RULE_CALCULATED",
            "HUMAN_ASSESSED",
            "UNKNOWN"
          ]
        },
        "methodology": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "band": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      ]
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "computed_at",
        "object_role"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "computed_at": {
          "$ref": "#/$defs/timestampOrState"
        },
        "object_role": {
          "enum": [
            "ORIGINAL",
            "WORKING_COPY",
            "DERIVATIVE"
          ]
        }
      }
    },
    "dataClassification": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "RESTRICTED",
          "INVESTIGATION_RESTRICTED",
          "LEGAL_SENSITIVE",
          "PERSONAL_DATA",
          "SENSITIVE_PERSONAL_DATA",
          "HEALTH_DATA",
          "CHILD_RELATED_DATA",
          "SECURITY_SENSITIVE",
          "MARKET_SENSITIVE",
          "UNKNOWN"
        ]
      }
    },
    "provenanceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "evidence_id",
        "source_page",
        "source_region",
        "bounding_box",
        "source_snippet"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "enum": [
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            }
          ]
        },
        "source_region": {
          "type": "string",
          "minLength": 1
        },
        "bounding_box": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "coordinate_system",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "coordinate_system": {
                  "enum": [
                    "PIXEL",
                    "PDF_POINT",
                    "NORMALIZED_0_1"
                  ]
                },
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "page_width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "page_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "source_snippet": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
