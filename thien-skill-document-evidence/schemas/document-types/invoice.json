  "line_item_definitions": [
    {"field_name": "line_number", "field_label": "Line number", "field_group": "line", "data_type": "IDENTIFIER", "required": false, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "IDENTIFIER_AS_TEXT"], "sensitivity": "STANDARD"},
    {"field_name": "item_code", "field_label": "Item or service code", "field_group": "line", "data_type": "IDENTIFIER", "required": false, "critical": true, "multiple": false, "normalization": ["PRESERVE_RAW", "IDENTIFIER_AS_TEXT"], "sensitivity": "STANDARD"},
    {"field_name": "description", "field_label": "Line description", "field_group": "line", "data_type": "TEXT", "required": true, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "UNICODE_NFC"], "sensitivity": "STANDARD"},
    {"field_name": "quantity", "field_label": "Quantity", "field_group": "line", "data_type": "QUANTITY", "required": true, "critical": true, "multiple": false, "normalization": ["PRESERVE_RAW", "DECIMAL_CANONICAL_STRING"], "sensitivity": "STANDARD"},
    {"field_name": "unit_of_measure", "field_label": "Unit of measure", "field_group": "line", "data_type": "UNIT_OF_MEASURE", "required": false, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "TRIM_OUTER_WHITESPACE"], "sensitivity": "STANDARD"},
    {"field_name": "unit_price", "field_label": "Unit price", "field_group": "line", "data_type": "CURRENCY_AMOUNT", "required": true, "critical": true, "multiple": false, "normalization": ["PRESERVE_RAW", "DECIMAL_CANONICAL_STRING"], "sensitivity": "FINANCIAL_SENSITIVE"},
    {"field_name": "tax_rate", "field_label": "Tax rate", "field_group": "line", "data_type": "PERCENTAGE", "required": false, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "DECIMAL_CANONICAL_STRING"], "sensitivity": "FINANCIAL_SENSITIVE"},
    {"field_name": "tax_amount", "field_label": "Line tax amount", "field_group": "line", "data_type": "CURRENCY_AMOUNT", "required": false, "critical": true, "multiple": false, "normalization": ["PRESERVE_RAW", "DECIMAL_CANONICAL_STRING"], "sensitivity": "FINANCIAL_SENSITIVE"},
    {"field_name": "line_total", "field_label": "Line total", "field_group": "line", "data_type": "CURRENCY_AMOUNT", "required": true, "critical": true, "multiple": false, "normalization": ["PRESERVE_RAW", "DECIMAL_CANONICAL_STRING"], "sensitivity": "FINANCIAL_SENSITIVE"},
    {"field_name": "po_line", "field_label": "Purchase order line reference", "field_group": "line_reference", "data_type": "IDENTIFIER", "required": false, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "IDENTIFIER_AS_TEXT"], "sensitivity": "STANDARD"},
    {"field_name": "grn_line", "field_label": "Goods receipt line reference", "field_group": "line_reference", "data_type": "IDENTIFIER", "required": false, "critical": false, "multiple": false, "normalization": ["PRESERVE_RAW", "IDENTIFIER_AS_TEXT"], "sensitivity": "STANDARD"}
  ],
  "validation_rules": [
    {"rule_id": "invoice.required-status", "rule_type": "REQUIRED_STATUS", "fields": ["invoice_number", "invoice_date", "seller_name", "buyer_name", "currency", "total_amount"], "severity": "CRITICAL", "description": "Every critical invoice field must exist as a field record with an explicit status."},
    {"rule_id": "invoice.identifier-text", "rule_type": "IDENTIFIER_AS_TEXT", "fields": ["invoice_number", "seller_tax_id", "buyer_tax_id", "seller_bank_account", "po_number", "contract_number", "grn_number"], "severity": "HIGH", "description": "Invoice and matching identifiers remain text and preserve leading zeros."},
    {"rule_id": "invoice.date-ambiguity", "rule_type": "DATE_AMBIGUITY", "fields": ["invoice_date", "due_date"], "severity": "HIGH", "description": "Ambiguous dates remain unnormalized and require review when material."},
    {"rule_id": "invoice.line-total", "rule_type": "MULTIPLICATION", "fields": ["quantity", "unit_price", "line_total"], "severity": "HIGH", "description": "Quantity multiplied by unit price is compared with line total without overwriting source values."},
    {"rule_id": "invoice.grand-total", "rule_type": "ARITHMETIC_SUM", "fields": ["subtotal", "discount_amount", "tax_amount", "freight_amount", "rounding_amount", "total_amount"], "severity": "CRITICAL", "description": "Invoice component totals are reconciled to the stated total."},
    {"rule_id": "invoice.amount-words", "rule_type": "AMOUNT_IN_WORDS_COMPARE", "fields": ["amount_in_words", "total_amount", "currency"], "severity": "MEDIUM", "description": "Amount in words is compared with numeric total when both are readable."}
  ],
  "reconciliation_keys": [
    {"key_id": "invoice.vendor-number", "fields": ["seller_tax_id", "invoice_number"], "strength": "PRIMARY", "candidate_only": false},
    {"key_id": "invoice.po-reference", "fields": ["po_number", "seller_tax_id"], "strength": "PRIMARY", "candidate_only": false},
    {"key_id": "invoice.amount-date", "fields": ["total_amount", "currency", "invoice_date"], "strength": "SUPPORTING", "candidate_only": true}
  ],
  "human_review_rules": [
    {"condition": "CRITICAL_FIELD_LOW_OR_UNKNOWN_CONFIDENCE", "field_scope": ["invoice_number", "invoice_date", "seller_tax_id", "currency", "total_amount", "seller_bank_account"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "AMBIGUOUS_DATE_OR_LOCALE", "field_scope": ["invoice_date", "due_date"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "ENGINE_DISAGREEMENT", "field_scope": ["tax_amount", "total_amount", "seller_bank_account"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "INCOMPLETE_TABLE", "field_scope": ["subtotal", "tax_amount", "total_amount"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "BANK_ACCOUNT_CONFLICT", "field_scope": ["seller_bank_account"], "action": "HUMAN_REVIEW_REQUIRED"}
  ],
  "claim_boundaries": [
    "NO_AUTHENTICITY_CONCLUSION",
    "NO_SIGNATURE_AUTHENTICATION",
    "NO_LEGAL_OPINION",
    "NO_FRAUD_CONCLUSION",
    "NO_CONTROL_EFFECTIVENESS_CONCLUSION"
  ]
}
