    {"field_name": "obligations", "field_label": "Obligation register", "field_group": "structure", "data_type": "TABLE", "required": false, "critical": true, "multiple": true, "normalization": ["PRESERVE_RAW"], "sensitivity": "LEGAL_SENSITIVE"}
  ],
  "line_item_definitions": [],
  "validation_rules": [
    {"rule_id": "contract.required-status", "rule_type": "REQUIRED_STATUS", "fields": ["contract_number", "contract_title", "contract_type", "parties", "effective_date"], "severity": "CRITICAL", "description": "Critical contract metadata requires explicit records and statuses."},
    {"rule_id": "contract.identifier-text", "rule_type": "IDENTIFIER_AS_TEXT", "fields": ["contract_number", "master_agreement_reference", "version", "amendment_number"], "severity": "HIGH", "description": "Contract and amendment identifiers remain text."},
    {"rule_id": "contract.date-order", "rule_type": "DATE_ORDER", "fields": ["execution_date", "effective_date", "start_date", "expiry_date", "renewal_date", "notice_deadline"], "severity": "HIGH", "description": "Date roles remain distinct and are compared without creating unstated legal consequences."},
    {"rule_id": "contract.currency-consistency", "rule_type": "CURRENCY_CONSISTENCY", "fields": ["price", "currency", "payment_schedule"], "severity": "HIGH", "description": "Commercial amounts retain their stated currencies and source references."},
    {"rule_id": "contract.signature-presence", "rule_type": "SIGNATURE_PRESENCE_ONLY", "fields": ["signature_blocks"], "severity": "INFO", "description": "Signature-block completeness and presence are recorded without authentication or validity conclusion."}
  ],
  "reconciliation_keys": [
    {"key_id": "contract.number-version", "fields": ["contract_number", "version", "amendment_number"], "strength": "PRIMARY", "candidate_only": false},
    {"key_id": "contract.master-reference", "fields": ["master_agreement_reference", "contract_number"], "strength": "SECONDARY", "candidate_only": false},
    {"key_id": "contract.parties-effective", "fields": ["parties", "effective_date"], "strength": "SUPPORTING", "candidate_only": true}
  ],
  "human_review_rules": [
    {"condition": "CRITICAL_FIELD_LOW_OR_UNKNOWN_CONFIDENCE", "field_scope": ["contract_number", "parties", "effective_date", "expiry_date", "price", "currency"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "AMBIGUOUS_DATE_OR_LOCALE", "field_scope": ["execution_date", "effective_date", "expiry_date", "renewal_date", "notice_deadline"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "MATERIAL_CLAUSE_OR_OBLIGATION", "field_scope": ["clauses", "obligations", "payment_terms", "termination_terms", "limitation_of_liability_terms"], "action": "HUMAN_REVIEW_REQUIRED"},
    {"condition": "MISSING_OR_TRUNCATED_PAGE", "field_scope": ["clauses", "obligations", "signature_blocks"], "action": "HUMAN_REVIEW_REQUIRED"}
  ],
  "claim_boundaries": ["NO_AUTHENTICITY_CONCLUSION", "NO_SIGNATURE_AUTHENTICATION", "NO_LEGAL_OPINION", "NO_FRAUD_CONCLUSION", "NO_CONTROL_EFFECTIVENESS_CONCLUSION"]
}
