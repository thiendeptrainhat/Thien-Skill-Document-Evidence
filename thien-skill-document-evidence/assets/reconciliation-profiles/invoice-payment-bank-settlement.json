{
  "$schema": "../../schemas/common/matching-profile.schema.json",
  "schema_version": "1.0.0",
  "profile_id": "INVOICE_PAYMENT_BANK_SETTLEMENT",
  "profile_version": "1.0.0",
  "profile_kind": "INVOICE_PAYMENT_BANK_SETTLEMENT",
  "title": "Invoice, payment request and bank settlement",
  "description": "Payment-allocation matching from invoice through payment request to an imported bank transaction.",
  "mode": "THREE_WAY",
  "grain": "PAYMENT_ALLOCATION",
  "roles": [
    {"role_id": "INVOICE", "label": "Invoice", "source_kind": "DOCUMENT", "document_types": ["INVOICE", "SUPPLIER_INVOICE"], "role_aliases": ["AP_INVOICE"], "required": true, "field_mappings": {"invoice_number": "invoice_number", "payment_reference": "invoice_number", "invoice_date": "invoice_date", "amount": "total_amount", "currency": "currency", "bank_account": "seller_bank_account"}, "output_sheet": "INVOICES"},
    {"role_id": "PAYMENT_REQUEST", "label": "Payment request", "source_kind": "DOCUMENT", "document_types": ["PAYMENT_REQUEST"], "role_aliases": ["PAYMENT_PROPOSAL"], "required": true, "field_mappings": {"invoice_number": "invoice_number", "payment_reference": "payment_reference", "request_date": "request_date", "amount": "requested_amount", "currency": "currency", "bank_account": "beneficiary_bank_account"}, "output_sheet": "PAYMENT_REQUESTS"},
    {"role_id": "BANK_TRANSACTION", "label": "Bank transaction", "source_kind": "SYSTEM_RECORD", "document_types": ["BANK_TRANSACTION", "BANK_STATEMENT_TRANSACTION"], "role_aliases": ["BANK_PAYMENT", "SETTLEMENT"], "required": true, "field_mappings": {"payment_reference": "transaction_reference", "booking_date": "booking_date", "amount": "signed_amount", "currency": "transaction_currency", "bank_account": "counterparty_account"}, "output_sheet": "BANK_TRANSACTIONS"}
  ],
  "match_rules": [
    {"rule_id": "invoice-to-payment-request", "left_role": "INVOICE", "right_role": "PAYMENT_REQUEST", "cardinality": "ONE_TO_ONE", "components": [
      {"component_id": "invoice-number", "left_field": "invoice_number", "right_field": "invoice_number", "comparator": "IDENTIFIER_EXACT", "normalizers": ["IDENTIFIER_PRESERVE"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}},
      {"component_id": "amount", "left_field": "amount", "right_field": "amount", "comparator": "DECIMAL_ABSOLUTE", "normalizers": ["DECIMAL_CANONICAL_STRING"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "RUN_REQUEST", "unit": "ABSOLUTE_AMOUNT", "approval_reference_required": true}},
      {"component_id": "currency", "left_field": "currency", "right_field": "currency", "comparator": "EXACT_TEXT", "normalizers": ["NONE"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}},
      {"component_id": "bank-account", "left_field": "bank_account", "right_field": "bank_account", "comparator": "IDENTIFIER_EXACT", "normalizers": ["IDENTIFIER_PRESERVE"], "required": false, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}}
    ], "partial_handling": {"mode": "HUMAN_REVIEW_REQUIRED", "allowed_relation": "NOT_APPLICABLE", "policy_source": "NOT_APPLICABLE"}, "missing_field_policy": "HUMAN_REVIEW_REQUIRED", "multiple_candidate_policy": "AMBIGUOUS_MATCH", "explicit_bridge": null},
    {"rule_id": "payment-request-to-bank", "left_role": "PAYMENT_REQUEST", "right_role": "BANK_TRANSACTION", "cardinality": "ONE_TO_ONE", "components": [
      {"component_id": "payment-reference", "left_field": "payment_reference", "right_field": "payment_reference", "comparator": "IDENTIFIER_EXACT", "normalizers": ["IDENTIFIER_PRESERVE"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}},
      {"component_id": "amount", "left_field": "amount", "right_field": "amount", "comparator": "DECIMAL_ABSOLUTE", "normalizers": ["DECIMAL_CANONICAL_STRING"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "RUN_REQUEST", "unit": "ABSOLUTE_AMOUNT", "approval_reference_required": true}},
      {"component_id": "currency", "left_field": "currency", "right_field": "currency", "comparator": "EXACT_TEXT", "normalizers": ["NONE"], "required": true, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}},
      {"component_id": "bank-account", "left_field": "bank_account", "right_field": "bank_account", "comparator": "IDENTIFIER_EXACT", "normalizers": ["IDENTIFIER_PRESERVE"], "required": false, "candidate_only": false, "tolerance_source": {"mode": "NOT_APPLICABLE", "unit": "NOT_APPLICABLE", "approval_reference_required": false}}
    ], "partial_handling": {"mode": "REQUIRE_APPROVED_RUN_POLICY", "allowed_relation": "RIGHT_LESS_THAN_OR_EQUAL_LEFT", "policy_source": "APPROVED_PROCESS_POLICY"}, "missing_field_policy": "HUMAN_REVIEW_REQUIRED", "multiple_candidate_policy": "AMBIGUOUS_MATCH", "explicit_bridge": null}
  ],
  "aggregation_rules": [],
  "comparison_basis": {"date": {"input_representation": "ISO_8601", "role_date_fields": {"INVOICE": "invoice_date", "PAYMENT_REQUEST": "request_date", "BANK_TRANSACTION": "booking_date"}, "ambiguous_date_policy": "HUMAN_REVIEW_REQUIRED", "window_source": "NOT_APPLICABLE"}, "currency": {"comparison_mode": "EXACT_CURRENCY_ONLY", "role_currency_fields": {"INVOICE": "currency", "PAYMENT_REQUEST": "currency", "BANK_TRANSACTION": "currency"}, "cross_currency_policy": "REQUIRE_APPROVED_ADAPTER", "exchange_rate_source": "REQUIRE_APPROVED_RUN_INPUT"}},
  "policy_sources": {"tolerance_values": "REQUIRE_APPROVED_RUN_INPUT", "partial_matching": "REQUIRE_APPROVED_RUN_INPUT_WHEN_ALLOWED", "currency_conversion": "EXACT_CURRENCY_UNLESS_APPROVED_ADAPTER", "materiality_use": "NOT_USED_AS_MATCH_TOLERANCE"},
  "exception_policy": {"partial_match": "REQUIRE_APPROVED_RUN_POLICY", "many_to_many": "REQUIRE_EXPLICIT_BRIDGE_AND_ALLOCATION", "duplicate": "FLAG_AND_REQUIRE_HUMAN_REVIEW", "missing_required_role": "FLAG_AND_REQUIRE_HUMAN_REVIEW", "missing_required_field": "HUMAN_REVIEW_REQUIRED", "ambiguous_candidate": "AMBIGUOUS_MATCH"},
  "review_rule": {"review_required_for": ["PARTIAL_MATCH", "AMBIGUOUS_MATCH", "CONFLICTING_MATCH", "UNMATCHED", "MISSING_REQUIRED_ROLE", "MISSING_REQUIRED_FIELD", "DUPLICATE_CONTENT", "UNCLASSIFIED_DOCUMENT", "PER_FILE_FAILURE"], "automatic_business_decision": false, "release_gate": "ACCOUNTABLE_HUMAN_REVIEW"},
  "workbook_contract": {"role_sheets": "ONLY_ROLES_WITH_RECORDS", "source_index": "ACCESSIBLE_INPUTS_ONLY", "run_log": "ACTUAL_EXECUTION_ONLY", "empty_sheet_policy": "DO_NOT_CREATE", "identifier_policy": "PRESERVE_AS_TEXT", "value_policy": "PRESERVE_RAW_AND_NORMALIZED", "provenance_policy": "FIELD_AND_SOURCE_REFERENCE", "formula_policy": "UNTRUSTED_TEXT_NEVER_FORMULA"},
  "limitations": ["A bank transaction candidate does not by itself prove final settlement, beneficiary identity, or authorization.", "Partial payment and amount tolerance require approved run-specific policy; materiality is never substituted for matching tolerance."]
}
