          "tolerance": {
            "status": "NOT_APPLICABLE",
            "value": null,
            "unit": "NOT_APPLICABLE",
            "basis": null,
            "owner": null,
            "approval_reference": null,
            "approval_status": "NOT_REQUESTED"
          }
        },
        {
          "component_id": "quantity",
          "left_field": "quantity",
          "right_field": "quantity",
          "comparator": "DECIMAL_ABSOLUTE",
          "normalizers": ["DECIMAL_CANONICAL_STRING"],
          "required": true,
          "candidate_only": false,
          "tolerance": {
            "status": "PROVIDED",
            "value": "0",
            "unit": "QUANTITY",
            "basis": "Exact quantity unless the documented partial-flow policy applies.",
            "owner": "Process Owner",
            "approval_reference": "APPROVAL-PARTIAL-001",
            "approval_status": "APPROVED"
          }
        },
        {
          "component_id": "currency",
          "left_field": "currency",
          "right_field": "currency",
          "comparator": "EXACT_TEXT",
          "normalizers": ["NONE"],
          "required": true,
          "candidate_only": false,
          "tolerance": {
            "status": "NOT_APPLICABLE",
            "value": null,
            "unit": "NOT_APPLICABLE",
            "basis": null,
            "owner": null,
            "approval_reference": null,
            "approval_status": "NOT_REQUESTED"
          }
        }
      ],
      "partial_policy": {
        "mode": "ALLOW_WHEN_DOCUMENTED",
        "allowed_relation": "RIGHT_LESS_THAN_OR_EQUAL_LEFT",
        "aggregation_id": null,
        "basis": "Invoices may cover a subset of an approved order quantity.",
        "owner": "Process Owner",
        "approval_reference": "APPROVAL-PARTIAL-001",
        "approval_status": "APPROVED"
      },
      "missing_field_policy": "HUMAN_REVIEW_REQUIRED",
      "multiple_candidate_policy": "AMBIGUOUS_MATCH"
